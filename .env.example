# Salin file ini menjadi ".env" lalu isi nilainya.
# File .env TIDAK ikut ter-upload ke GitHub (sudah ada di .gitignore).
# JANGAN tempel isi .env ke chat mana pun.

# --- Jaringan ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# --- Wallet deployer ---
# Private key deployer TIDAK disimpan di sini. Ia disimpan terenkripsi di keystore Foundry:
#   cast wallet import deployer --interactive

# --- Wallet signer server (BERBEDA dari deployer, tanpa saldo) ---
SIGNER_PRIVATE_KEY=
SIGNER_ADDRESS=

# --- Kontrak (diisi setelah deploy) ---
BADGE_ADDRESS=

# --- Verifikasi kontrak di Basescan / Etherscan v2 ---
ETHERSCAN_API_KEY=

# --- Coinbase Developer Platform (paymaster) ---
CDP_API_KEY=
PAYMASTER_URL=

# --- Claude API (generator soal) ---
ANTHROPIC_API_KEY=

# --- Grant Radar (Fase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
